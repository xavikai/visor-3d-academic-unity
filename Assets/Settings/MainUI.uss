.main-container {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 10px;
}

.panel {
    background-color: rgba(20, 20, 25, 0.95);
    border-radius: 14px;
    padding: 14px;
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
}

.side-panel {
    width: 250px;
    height: 100%;
}

.right-panel {
    width: 140px;
    height: 100%;
}

.header-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    padding-bottom: 5px;
}

.section {
    margin-top: 10px;
    margin-bottom: 5px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    padding: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(200, 200, 220);
    margin-bottom: 5px;
}

.text-center {
    -unity-text-align: middle-center;
}

.control-element {
    margin-top: 3px;
    margin-bottom: 3px;
    color: rgb(220, 220, 220);
    flex-shrink: 0;
    min-height: 20px;
    font-size: 11px;
}

/* Ajustaments pel Dropdown */
.unity-base-popup-field {
    min-height: 24px;
}

.unity-base-popup-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
}

.unity-base-popup-field__input:hover {
    border-color: rgb(80, 160, 255);
}

.unity-base-popup-field__text {
    color: white;
    -unity-text-align: middle-left;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Llista desplegable interna */
.unity-base-dropdown__container-outer {
    background-color: rgb(40, 40, 45);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
}

.unity-base-dropdown__item {
    min-height: 22px;
}

.unity-base-dropdown__item:hover {
    background-color: rgb(80, 160, 255);
}

.unity-base-dropdown__label {
    color: white;
    font-size: 11px;
    padding-left: 5px;
}

.control-element > .unity-label {
    min-width: 90px;
}

#ModelDropdown > .unity-label, #MaterialDropdown > .unity-label {
    min-width: 45px;
    padding-right: 5px;
}

#ModelDropdown, #MaterialDropdown {
    width: 100%;
}

.row-group {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.half-toggle {
    flex-grow: 1;
    margin-right: 2px;
}

.half-toggle > .unity-label {
    min-width: 75px;
}

.compact-slider {
    flex-grow: 2;
    margin-left: 2px;
}

.full-slider {
    flex-grow: 1;
    width: 100%;
}

.advanced-toggle {
    margin-right: 2px;
}

.advanced-toggle > .unity-label {
    min-width: 0px;
    padding-right: 2px;
    font-size: 10px;
}

/* Customizing the slider */
.slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.5);
    height: 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.slider .unity-base-slider__dragger {
    background-color: rgb(80, 160, 255);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-top: -5px;
}

.slider .unity-base-slider__dragger:hover {
    background-color: rgb(120, 190, 255);
    scale: 1.1;
}

/* Customizing toggles */
.unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    border-width: 1px;
    -unity-background-image-tint-color: rgb(80, 160, 255);
}

.unity-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(80, 160, 255);
}

.flex-spacer {
    flex-grow: 1;
}

.stats-section {
    background-color: rgba(0, 0, 0, 0.4);
    border-left-width: 4px;
    border-left-color: rgb(80, 160, 255);
}

.stats-text {
    color: rgb(180, 220, 255);
    font-size: 11px;
}

.controls-scroll {
    flex-grow: 1;
    min-height: 0;
}

.export-button {
    margin-top: 6px;
    min-height: 28px;
    background-color: rgb(43, 99, 155);
    color: white;
    border-radius: 5px;
}

.export-status {
    white-space: normal;
    font-size: 10px;
    color: rgb(175, 195, 215);
    margin-top: 6px;
}

.lighting-section .control-element > .unity-label {
    min-width: 55px;
    width: 55px;
    max-width: 55px;
}

.lighting-section > .unity-foldout__toggle,
.lighting-section > .unity-foldout__toggle .unity-toggle__text {
    color: rgb(200, 210, 230);
    font-size: 11px;
    -unity-font-style: bold;
}

.lighting-section > .unity-foldout__content {
    margin-left: 0;
}

#BackgroundChoice > .unity-label {
    min-width: 0;
    width: auto;
    max-width: none;
}

#BackgroundChoice { flex-direction: column; }

#BackgroundChoice .unity-base-popup-field__text {
    font-size: 11px;
}

#HdriEnabled > .unity-label, #ShowHdriBackground > .unity-label {
    min-width: 110px;
    width: 110px;
    max-width: 110px;
}

#TurntableResolution > .unity-label, #TurntableDuration > .unity-label {
    min-width: 50px;
    width: 50px;
    max-width: 50px;
}

.controls-scroll .unity-scroller--vertical {
    width: 10px;
    margin-left: 5px;
}

.controls-scroll .unity-scroller__low-button,
.controls-scroll .unity-scroller__high-button {
    display: none;
}

.controls-scroll .unity-scroller .unity-base-slider__tracker {
    background-color: rgb(25, 25, 30);
    border-width: 0;
}

.controls-scroll .unity-scroller .unity-base-slider__dragger {
    background-color: rgb(85, 90, 100);
    border-width: 0;
    border-radius: 4px;
}

.gallery-scroll {
    flex-grow: 1;
}

.texture-item {
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    padding: 4px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.texture-label {
    color: rgb(200, 200, 200);
    font-size: 10px;
    margin-bottom: 1px;
}

.texture-preview {
    width: 60px;
    height: 60px;
    border-radius: 6px;
    background-color: rgb(40, 40, 40);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.texture-preview:hover {
    border-color: rgb(80, 160, 255);
    border-width: 2px;
}

/* Modal de Zoom */
.zoom-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.zoom-content {
    background-color: rgb(30, 30, 35);
    border-radius: 12px;
    padding: 20px;
    width: 80%;
    height: 80%;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.zoom-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.close-btn {
    background-color: rgb(200, 60, 60);
    color: white;
    -unity-font-style: bold;
    border-radius: 6px;
    width: 30px;
    height: 30px;
    border-width: 0;
}

.close-btn:hover {
    background-color: rgb(255, 80, 80);
}

.zoom-image {
    flex-grow: 1;
    background-color: black;
    border-radius: 8px;
}

/* Logo de l'Escola */
.logo-container {
    margin-top: auto;
    margin-bottom: 0px;
    align-items: center;
    justify-content: center;
}

.school-logo {
    width: 100px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
}
